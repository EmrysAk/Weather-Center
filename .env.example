# Weather Center — environment template. Copy to .env and fill in.
# The real .env is gitignored; never commit it.

# ── Service ───────────────────────────────────────────────────────────
# Service port table: 3001 Brief SE · 3002 Sports Center · 3003 Newsroom ·
# 3004 Prediction Lab · 3005 Military Center · 3006 Weather Center
PORT=3006
# Allowed browser origins (comma list). Empty = same-origin only.
CORS_ORIGINS=
# Reverse proxies in front (1 behind nginx) so the auth lockout sees real IPs.
TRUST_PROXY=1
# Identify yourself to the data providers you poll (they ask for a contact).
CENTER_USER_AGENT=Weather Center your-email@example.com

# ── The newsroom (where the weather desk's stories come from) ─────────
# Mint the token ON the newsroom box: node scripts/make-token.js "weather-center"
NEWSROOM_URL=http://127.0.0.1:3003
NEWSROOM_TOKEN=
# How often to pull new weather-desk rows (ms). Default 2 minutes.
NEWSROOM_POLL_MS=120000

# ── Optional keyed sources ────────────────────────────────────────────
# NASA FIRMS active-fire hotspots (free MAP_KEY from firms.modaps.eosdis.nasa.gov).
# Without it the FIRE panel still shows InciWeb incidents.
FIRMS_MAP_KEY=

# ── Operations ────────────────────────────────────────────────────────
# 1 = no background polling (tests, dry runs)
POLL_DISABLED=0
# Rows of the weather desk kept in the local mirror (newest kept)
MIRROR_MAX_ROWS=20000

# ── Auth ──────────────────────────────────────────────────────────────
# Prefer: node scripts/make-token.js "name"  (writes hashes to data/tokens.json)
# Or comma-separated sha256 hashes:
# AUTH_TOKEN_HASHES=
